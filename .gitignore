# 데이터·산출물 — 용량이 커서 구글드라이브로 공유
data/
outputs/*
!outputs/results/

# 서명·생년월일이 들어간 제출본 — 비공개 저장소라도 이력에 남기지 않음
docs/**/*과제수행계획서(*).pdf
docs/**/*결과보고서(*).pdf
docs/capstone2/\[학생\]*.hwp

# 개인 도구 설정 — graphify·Claude Code 훅은 윈도우 PC 전용
graphify-out/
.claude/
CLAUDE.md

# 파이썬
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
desktop.ini

# 완료 배치의 집계·run_metadata.json만 공유 (개별 실행은 로컬 보존)
outputs/results/feature_group_*_random_*_s[012]/
outputs/results/feature_group_*_pattern_group_*_s[012]/
outputs/results/sequence_controls_*_random_*_s[012]/
outputs/results/sequence_controls_*_pattern_group_*_s[012]/

# 앞 k개 평가: 배치 집계·아카이브만 공유
outputs/results/sequence_prefix_*_random_*_s[012]/
outputs/results/sequence_prefix_*_pattern_group_*_s[012]/

# 행 ID 복원 오류로 학습 전 중단된 0/36 실행 기록은 로컬 보존
outputs/results/sequence_prefix_2026-10-31_mac/

# 미확인 문턱 평가: 개별 중복 집계는 로컬, 배치 아카이브만 공유
outputs/results/ood_threshold_*_random_rf_*_s[012]/
outputs/results/ood_threshold_*_pattern_group_rf_*_s[012]/
